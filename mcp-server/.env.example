# ===== แม่แบบ — คัดลอกเป็น .env.claude / .env.manus / .env.chatgpt แล้วแก้ AGENT + AGENT_PREFIX =====
# ใช้ System User แยกของ ชื่อ Agent (Business Settings > Users > System Users)
# สิทธิ์ที่ต้องมี: ads_management, ads_read, business_management, pages_show_list (+ pages_read_engagement)
# ห้าม commit ไฟล์นี้ — อยู่ใน .gitignore แล้ว
AGENT=claude
META_ACCESS_TOKEN=ใส่โทเคนของ ชื่อ Agent
META_AD_ACCOUNT_ID=act_ใส่เลขบัญชี
META_PAGE_ID=ใส่เลขเพจ
# ใส่เฉพาะเมื่อใช้ OUTCOME_SALES / OUTCOME_LEADS
META_PIXEL_ID=
# เลขผู้ลงโฆษณาที่ยืนยันตัวตนแล้ว — Meta บังคับสำหรับโฆษณาที่ยิงในไทย (ไม่ใส่จะสร้าง Ad Set ไม่ได้)
META_VERIFIED_IDENTITY_ID=
AGENT_PREFIX=CLD-
MAX_DAILY_BUDGET_THB=1000
MAX_CAMPAIGNS_PER_DAY=5
GRAPH_API_VERSION=v21.0

# ส่งผลเข้า Dashboard (ค่า SECRET ต้องตรงกับ dashboard/.env.local)
DASHBOARD_API_URL=http://localhost:3000/api/ingest
DASHBOARD_API_SECRET=เปลี่ยนเป็นรหัสลับยาวๆ

# ปุ่ม ✨ ให้ AI คิดกลุ่มเป้าหมาย (ไม่บังคับ) — claude/manus ใช้ ANTHROPIC_API_KEY · chatgpt ใช้ OPENAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# เว้นว่าง = claude-haiku-5-5 (Claude) / gpt-4o-mini (OpenAI)
AI_MODEL=

# เฉพาะโหมด --http (Manus / ChatGPT)
MCP_HTTP_TOKEN=
MCP_PUBLIC_HOST=
