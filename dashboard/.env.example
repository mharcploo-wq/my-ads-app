# คัดลอกเป็น .env.local (ไฟล์นี้ไม่ถูก commit)
# ต้องตรงกับ DASHBOARD_API_SECRET ใน mcp-server/.env.*  (อย่างน้อย 12 ตัวอักษร)
DASHBOARD_API_SECRET=เปลี่ยนเป็นรหัสลับยาวๆ

# (ไม่บังคับ) ให้ Dashboard ดึงข้อมูลจาก Meta ตรง — ใช้โทเคนสิทธิ์ ads_read อย่างเดียวพอ
# โทเคนนี้อยู่ฝั่ง server เท่านั้น ไม่ถูกส่งไปที่เบราว์เซอร์
META_READ_TOKEN=
META_AD_ACCOUNT_ID=act_ใส่เลขบัญชี
GRAPH_API_VERSION=v21.0
